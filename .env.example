# ─────────────────────────────────────────────────────────────────────────────
# GQAI 법령조회 MCP — 환경변수
#
# 이 파일은 '이름과 의미'만 담는 템플릿이다. 실제 값은 절대 여기 적지 않는다.
# 운영 값은 Vercel 프로젝트 환경변수(Secret)에만 저장한다.
# 로컬 검증이 필요하면 이 파일을 .env.local로 복사해 채운다(.gitignore 대상).
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. 필수 ──────────────────────────────────────────────────────────────────

# 법제처 OPEN API 인증키(OC). 공용 서버 키로 쓰이며 사용자에게 노출되지 않는다.
# 발급/변경: https://open.law.go.kr/  (마이페이지 → API 인증키 관리)
# ⚠️ 화면 공유로 노출된 이력이 있으므로 배포 전 반드시 새 값으로 변경할 것(계획서 2.2절).
LAW_OC=

# ── 2. 전역 캐시·한도 저장소 (Redis) ─────────────────────────────────────────
# 없으면 캐시가 꺼지고 한도는 인스턴스별 인메모리로 degrade한다.
# 그 상태로는 계획서 관문 C(다중 인스턴스 일관성)를 통과할 수 없으므로 사실상 필수.
# Upstash 표준 이름과 Vercel KV 표준 이름 중 어느 쪽이든 인식한다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (대안) KV_REST_API_URL= / KV_REST_API_TOKEN=

# ── 3. Synthetic 감시 (Vercel Cron) ──────────────────────────────────────────

# /api/synthetic 보호용 임의 문자열. 미설정 시 엔드포인트가 인증 없이 열린다.
# 생성 예: openssl rand -hex 32
CRON_SECRET=

# ── 4. 공용 키 보호 한도 ─────────────────────────────────────────────────────

# 서버 OC 전체의 분당 상한 (자체 키 없는 요청 전원이 공유)
FALLBACK_RATE_LIMIT_RPM=120
# 버스트 허용량. 미설정 시 RPM과 같은 값
FALLBACK_RATE_LIMIT_BURST=180
# 서버 OC 일일 상한. 0이면 무제한 — 공개 운영에서는 반드시 설정한다.
# 단계 0에서 확인한 법제처 실제 쿼터의 70~80% 수준으로 잡는다(계획서 3.4절).
FALLBACK_DAILY_CAP=5000

# IP별 분당 상한. '사용자 식별'이 아니라 '봇 방어' 목적이다 —
# 원격 MCP 클라이언트는 소수 egress IP를 공유하므로 넉넉하게 잡아야 한다(3.4절).
RATE_LIMIT_RPM=120

# 한 POST에 담을 수 있는 tools/call 개수. 배치 증폭으로 한도를 우회하는 것을 막는다.
MCP_MAX_BATCH_CALLS=20

# 요청 본문 크기 상한
MCP_BODY_LIMIT=100kb

# ── 5. 캐시 정책 ─────────────────────────────────────────────────────────────

# 조문·법령 전문 TTL(초). 개정 전까지 불변이라 길게 잡는다.
CACHE_TTL_LAW=86400
# 검색 결과 TTL(초). 신규 제·개정 반영 지연을 감안해 짧게.
CACHE_TTL_SEARCH=3600
# 캐시에 담을 응답 본문 상한(바이트)
CACHE_MAX_BYTES=524288
# 캐시를 일시적으로 끄려면 1 (장애 진단용)
# CACHE_DISABLED=0

# ── 6. 접근 통제 ─────────────────────────────────────────────────────────────

# 비공개 베타 기간의 접근 토큰. 설정되면 /mcp 호출 시 x-mcp-token 또는
# Authorization: Bearer 로 제시해야 한다. 완전 공개 시 제거.
MCP_AUTH_TOKEN=

# 추가 허용 Host (쉼표 구분). law.gqai.kr / *.vercel.app / localhost는 기본 허용.
# ALLOWED_HOSTS=

# 브라우저 클라이언트를 쓸 때만 설정. 미설정이면 Origin 헤더가 붙은 요청은 차단된다.
# ALLOWED_ORIGINS=https://example.com

# 쿼리스트링(?oc=)으로 인증키 전달 허용 여부. 엣지 로그에 평문으로 남으므로 기본 차단.
# ALLOW_QUERY_API_KEY=0

# ── 7. 법제처 호출 세부 (기본값 권장) ────────────────────────────────────────

# 법제처는 Referer가 없으면 OC가 유효해도 인증 실패 XML을 반환한다.
# LAW_REFERER=https://www.law.go.kr/
# 클라우드 User-Agent 차단 대응. 정책 변경 시에만 override.
# LAW_USER_AGENT=
# XML 엔드포인트 장애 시 우회
# LAW_RESPONSE_TYPE=XML

# ── 8. 운영 보조 ─────────────────────────────────────────────────────────────

# 접근 로그 활성화 (경로만 기록, 쿼리스트링 미기록)
# ACCESS_LOG=1
# 신뢰할 프록시 홉 수. Vercel 엣지는 1단.
# TRUST_PROXY=1
# MCP 클라이언트에 표시될 서버 이름
# MCP_SERVER_NAME=gqai-law
# Preview/Production이 같은 Redis를 공유할 때 키 충돌 방지 (기본: gqai:${VERCEL_ENV})
# LIMIT_PREFIX=
