# 설치 복원력 설정
#
# Vercel 첫 빌드는 npm 캐시가 비어 있어 132MB를 전량 내려받는다. 그중
# pdfjs-dist 하나가 40MB라, 레지스트리 연결이 한 번 끊기면(ECONNRESET)
# 기본 재시도(2회·짧은 백오프)로는 복구되지 않고 설치가 통째로 실패한다.
# 재시도 횟수와 백오프 상한을 늘려 일시적 네트워크 장애를 넘긴다.
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000
fetch-timeout=300000

# audit은 의존성 트리 전체를 레지스트리에 POST하는 별도 왕복이고,
# fund는 설치 후 추가 조회를 유발한다. 배포 경로에서는 둘 다 불필요한
# 네트워크 작업이라 끈다. 취약점 점검은 로컬에서 `npm audit`으로 따로 한다.
audit=false
fund=false
